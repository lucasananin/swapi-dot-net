<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Star Wars Explorer</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Swapi.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="navbar">
        <div class="nav-container">
            <a class="logo" asp-controller="Home" asp-action="Index">
                Star Wars Explorer
            </a>

            <nav>
                <ul class="nav-links">
                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="people">
                            Characters
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="planets">
                            Planets
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="films">
                            Films
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="species">
                            Species
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="starships">
                            Starships
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Index" asp-route-resource="vehicles">
                            Vehicles
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Resources" asp-action="Favorites">Favorites</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="page-content">
        @RenderBody()
    </main>

    @* <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Swapi</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Swapi - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false) *@
</body>

</html>
