@model Swapi.Models.ViewModels.PaginationViewModel

<nav class="pagination">

    @if (Model.HasPrevious)
    {
        <a asp-route-resource="@Model.Resource" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage - 1)">
            Previous
        </a>
    }

    @foreach (var page in Model.GetVisiblePages())
    {
        if (page == Model.CurrentPage)
        {
            <strong>page</strong>
        }
        else
        {
            <a asp-route-resource="@Model.Resource" asp-route-search="@Model.Search" asp-route-page="page">
                page
            </a>
        }
    }

    @if (Model.HasNext)
    {
        <a asp-route-resource="@Model.Resource" asp-route-search="@Model.Search" asp-route-page="@(Model.CurrentPage + 1)">
            Next
        </a>
    }

</nav>