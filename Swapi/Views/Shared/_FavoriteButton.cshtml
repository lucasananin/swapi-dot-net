@model Swapi.Models.ViewModels.ResourceDetailsViewModel

<form asp-controller="Resources" asp-action="ToggleFavorite" method="post">

    @* <input type="hidden" name="resource" value="people" /> *@
    <input type="hidden" name="resource" value=@ViewData["Resource"] />
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit">
        @(Model.IsFavorite ? "★ Remove from favorites" : "☆ Add to favorites")
    </button>

</form>