@model Swapi.Models.ViewModels.PersonDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<div class="details-grid">

    <div class="detail-row">
        <strong>Height</strong>
        <span>@Model.Height cm</span>
    </div>

    <div class="detail-row">
        <strong>Mass</strong>
        <span>@Model.Mass kg</span>
    </div>

    <div class="detail-row">
        <strong>Birth Year</strong>
        <span>@Model.BirthYear</span>
    </div>

    <div class="detail-row">
        <strong>Gender</strong>
        <span>@Model.Gender</span>
    </div>

</div>

<partial name="_FavoriteButton" model="@Model" view-data='new ViewDataDictionary(ViewData)
         {
             ["Resource"] = "people"
         }' />

